---
import '../styles/global.css';

interface Props {
	title: string;
	description?: string;
}

const {
	title,
	description = 'First Fragment creates archaeology-inspired games about exploration, excavation, and discovery.',
} = Astro.props;
const baseUrl = import.meta.env.BASE_URL.endsWith('/')
	? import.meta.env.BASE_URL
	: `${import.meta.env.BASE_URL}/`;
if (!Astro.site) {
	throw new Error('Configure the site URL in astro.config.mjs to generate social metadata.');
}
const pageUrl = new URL(Astro.url.pathname, Astro.site);
const socialImageUrl = new URL(`${baseUrl}social/first-fragment.png`, Astro.site);
const socialImageAlt = 'First Fragment Studio - Unearth lost worlds. Reveal forgotten histories.';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href={`${baseUrl}favicon.svg`} />
		<link rel="icon" href={`${baseUrl}favicon.ico`} />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#0b0a08" />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="First Fragment Studio" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={pageUrl.href} />
		<meta property="og:image" content={socialImageUrl.href} />
		<meta property="og:image:type" content="image/png" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={socialImageAlt} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={socialImageUrl.href} />
		<meta name="twitter:image:alt" content={socialImageAlt} />
		<title>{title}</title>
	</head>
	<body>
		<header class="site-header">
			<a class="site-brand" href={baseUrl}>First Fragment Studio</a>
		</header>
		<slot />
	</body>
</html>

<style>
	.site-header {
		display: flex;
		min-height: 4.5rem;
		align-items: center;
		padding-inline: max(2rem, calc((100vw - 1200px) / 2));
		border-bottom: 1px solid rgb(255 255 255 / 10%);
		background: #0b0a08;
	}

	.site-brand {
		color: #d7b98a;
		font-size: .8rem;
		font-weight: 700;
		letter-spacing: .12em;
		text-transform: uppercase;
	}

	.site-brand:focus-visible {
		outline: 2px solid #caa255;
		outline-offset: 5px;
	}

	@media (max-width: 520px) {
		.site-header {
			padding-inline: 1.25rem;
		}
	}
</style>
