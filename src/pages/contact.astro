---
import Layout from '../layouts/Layout.astro';

const email = 'info@firstfragmentstudio.com';
---

<Layout
	title="Contact | First Fragment"
	description="Get in touch with First Fragment about our games and studio."
>
	<main class="contact-page">
		<div class="container">
			<a class="back-link" href="/">← First Fragment</a>
			<section aria-labelledby="contact-title">
				<span class="eyebrow">Get in Touch</span>
				<h1 id="contact-title">Contact First Fragment</h1>
				<p class="intro">
					Have a question about our studio or games? Send us an email and we’ll be glad to hear from you.
				</p>
				<a class="email-link" href={`mailto:${email}`}>{email}</a>
			</section>
		</div>
	</main>
</Layout>

<style>
	:global(body) {
		margin: 0;
		background: #0b0a08;
		color: #f8f6f2;
		font-family: "Avenir Next", Avenir, "Segoe UI", sans-serif;
	}

	.contact-page {
		display: flex;
		min-height: 100svh;
		align-items: center;
		padding: 3rem 2rem;
		background: radial-gradient(ellipse at 75% 38%, rgb(202 162 85 / 20%), transparent 50%), #0b0a08;
	}

	.container {
		width: min(900px, 100%);
		margin: auto;
	}

	.back-link {
		display: inline-block;
		margin-bottom: clamp(4rem, 12vh, 8rem);
		color: #d7b98a;
		font-size: .8rem;
	}

	.eyebrow {
		color: #caa255;
		font-size: .72rem;
		font-weight: 600;
		letter-spacing: .18em;
		text-transform: uppercase;
	}

	h1 {
		margin: 1.2rem 0;
		font-family: Georgia, "Times New Roman", serif;
		font-size: clamp(3rem, 9vw, 6.5rem);
		font-weight: 400;
		letter-spacing: -.055em;
		line-height: 1;
	}

	.intro {
		max-width: 600px;
		margin: 1.5rem 0 2rem;
		color: #c9c0b2;
		font-size: 1.05rem;
		line-height: 1.85;
	}

	.email-link {
		display: inline-block;
		padding-bottom: .5rem;
		border-bottom: 1px solid #caa255;
		color: #f8f6f2;
		font-size: clamp(1rem, 3vw, 1.25rem);
		font-weight: 600;
		overflow-wrap: anywhere;
	}

	.email-link:focus-visible {
		outline: 2px solid #caa255;
		outline-offset: 5px;
	}

	@media (max-width: 520px) {
		.contact-page {
			padding-inline: 1.25rem;
		}
	}
</style>
