---
import Layout from '../layouts/Layout.astro';
---

<Layout
	title="First Fragment | Archaeology Games"
	description="Unearth lost worlds and reveal forgotten histories in archaeology-driven adventures from First Fragment."
>
	<main>
		<section class="hero" aria-labelledby="hero-title">
			<div class="container">
				<span class="eyebrow">Independent Game Studio</span>
				<h1 id="hero-title">Unearth Lost Worlds.<br />Reveal Forgotten Histories.</h1>
				<p class="lead">
					Every artifact has a story. Every ruin hides a secret. First Fragment creates
					archaeology-driven games where exploration, excavation, and discovery are at the heart of
					every adventure.
				</p>
				<div class="actions">
					<a class="btn btn-primary" href="#featured-game">Explore Our Games</a>
					<a class="btn btn-secondary" href="#development-updates">Follow Development</a>
				</div>
			</div>
		</section>

		<section class="featured-game" id="featured-game" aria-labelledby="game-title">
			<div class="container feature-layout">
				<div class="feature-art" aria-hidden="true">
					<span class="sun"></span>
					<span class="ruin"></span>
					<span class="feature-art-label">FIELD NOTES · № 001</span>
				</div>
				<div class="feature-copy">
					<span class="section-label">Featured Game</span>
					<h2 id="game-title">Fragments of Eternity</h2>
					<p class="game-subtitle">A story-driven archaeological adventure.</p>
					<p>
						Lead expeditions into uncharted ruins, uncover fragments of a lost civilization, and
						piece together a mystery thousands of years in the making.
					</p>
					<ul>
						<li>Discover hidden dig sites</li>
						<li>Carefully excavate ancient artifacts</li>
						<li>Reconstruct lost technologies</li>
						<li>Uncover the truth behind a forgotten empire</li>
					</ul>
					<a class="text-link" href="#community">Wishlist on Steam <span aria-hidden="true">↗</span></a>
				</div>
			</div>
		</section>

		<section class="philosophy" aria-labelledby="philosophy-title">
			<div class="container philosophy-inner">
				<span class="section-label">Our Philosophy</span>
				<h2 id="philosophy-title">Discovery Before Destruction</h2>
				<p class="philosophy-lead">Most games reward combat.<br /><strong>Our games reward curiosity.</strong></p>
				<p>
					We believe the thrill of uncovering a forgotten artifact, decoding an ancient inscription,
					or revealing a lost chamber can be just as exciting as any battle.
				</p>
				<p class="highlight">Every fragment tells a story.</p>
			</div>
		</section>

		<section class="pillars" aria-labelledby="pillars-title">
			<div class="container">
				<span class="section-label">The Work of Discovery</span>
				<h2 id="pillars-title">Gameplay Pillars</h2>
				<div class="grid">
					<article class="card">
						<span class="card-icon" aria-hidden="true">⛏</span>
						<h3>Excavation</h3>
						<p>Carefully uncover artifacts and relics without damaging priceless discoveries.</p>
					</article>
					<article class="card">
						<span class="card-icon" aria-hidden="true">⌖</span>
						<h3>Exploration</h3>
						<p>Journey across deserts, jungles, mountains, and forgotten cities in search of lost knowledge.</p>
					</article>
					<article class="card">
						<span class="card-icon" aria-hidden="true">◈</span>
						<h3>Reconstruction</h3>
						<p>Piece together broken fragments to reveal ancient tools, treasures, and forgotten histories.</p>
					</article>
					<article class="card">
						<span class="card-icon" aria-hidden="true">⌁</span>
						<h3>Discovery</h3>
						<p>Translate inscriptions, solve historical puzzles, and uncover civilizations erased by time.</p>
					</article>
				</div>
			</div>
		</section>

		<section class="about" aria-labelledby="about-title">
			<div class="container about-inner">
				<div class="about-art" aria-hidden="true">
					<span class="about-sun"></span>
					<span class="pyramid pyramid-back"></span>
					<span class="pyramid pyramid-front"></span>
					<span class="coordinates">29° 58′ 45.0″ N<br />31° 08′ 03.0″ E</span>
				</div>
				<div class="about-copy">
					<span class="section-label">A Small Studio, a Deep Past</span>
					<h2 id="about-title">About First Fragment</h2>
					<p>
						First Fragment is an independent game studio dedicated to creating archaeology-inspired
						adventures.
					</p>
					<p>
						Our games are built around exploration, mystery, and the excitement of discovery. We
						draw inspiration from real archaeological expeditions, ancient cultures, and humanity's
						endless fascination with the past.
					</p>
					<p class="highlight">We create worlds where curiosity is the greatest tool you'll carry.</p>
				</div>
			</div>
		</section>

		<section class="updates" id="development-updates" aria-labelledby="updates-title">
			<div class="container">
				<div class="section-heading">
					<div>
						<span class="section-label">Development Updates</span>
						<h2 id="updates-title">From the Field Notes</h2>
					</div>
					<p>Read the latest excavation reports from our development team.</p>
				</div>
				<div class="grid update-grid">
					<article class="card"><span class="update-number">01</span><h3>Designing Authentic Excavation Mechanics</h3></article>
					<article class="card"><span class="update-number">02</span><h3>Creating Ancient Ruins Players Can Explore</h3></article>
					<article class="card"><span class="update-number">03</span><h3>Building Artifact Reconstruction Systems</h3></article>
					<article class="card"><span class="update-number">04</span><h3>Researching Historical Civilizations</h3></article>
				</div>
				<a class="text-link" href="#community">Read the Dev Blog <span aria-hidden="true">↗</span></a>
			</div>
		</section>

		<section class="community" id="community" aria-labelledby="community-title">
			<div class="container">
				<span class="section-label">The Next Chapter Is Unwritten</span>
				<h2 id="community-title">Join the Expedition</h2>
				<p>Follow development, share discoveries, and help shape the future of archaeology gaming.</p>
				<div class="actions">
					<a class="btn btn-primary" href="#development-updates">Join Discord</a>
					<a class="btn btn-secondary" href="#featured-game">Follow on Steam</a>
				</div>
			</div>
		</section>
	</main>

	<footer class="site-footer">
		<a class="footer-brand" href="#hero-title">First Fragment</a>
		<p>Every fragment tells a story.</p>
		<a href="#hero-title">Back to the surface ↑</a>
	</footer>
</Layout>

<style>
	:global(:root) {
		font-family: "Avenir Next", Avenir, "Segoe UI", sans-serif;
		color: var(--text);
		background: var(--bg);
		font-synthesis: none;
		text-rendering: optimizeLegibility;
		scroll-behavior: smooth;
		--bg: #0b0a08;
		--surface: #171411;
		--card: #211c17;
		--sand: #d7b98a;
		--gold: #caa255;
		--text: #f8f6f2;
		--muted: #c9c0b2;
	}

	:global(*) { box-sizing: border-box; }
	:global(body) { margin: 0; }
	:global(::selection) { color: var(--bg); background: var(--gold); }
	:global(a) { color: inherit; }
	.container { width: min(1200px, calc(100% - 4rem)); margin: auto; }
	section { padding: 6rem 2rem; }
	h1, h2, h3, p { overflow-wrap: anywhere; }
	h2 { margin: 1rem 0 1.5rem; font-family: Georgia, "Times New Roman", serif; font-size: clamp(2.2rem, 5vw, 4rem); font-weight: 400; letter-spacing: -.045em; line-height: 1.04; }
	.hero { display: flex; min-height: min(800px, 92svh); align-items: center; background: radial-gradient(ellipse at 77% 42%, rgb(202 162 85 / 24%), transparent 48%), linear-gradient(120deg, #0b0a08 25%, #211b12 100%); }
	.hero .container { padding: 4rem 0; }
	.eyebrow, .section-label { color: var(--gold); font-size: .72rem; font-weight: 600; letter-spacing: .18em; text-transform: uppercase; }
	.hero h1 { max-width: 950px; margin: 1.4rem 0; font-family: Georgia, "Times New Roman", serif; font-size: clamp(3rem, 8vw, 6rem); font-weight: 400; letter-spacing: -.055em; line-height: .99; }
	.hero h1 br + * { color: var(--sand); }
	.lead { max-width: 700px; color: var(--muted); font-size: clamp(1rem, 1.4vw, 1.2rem); line-height: 1.85; }
	.actions { display: flex; flex-wrap: wrap; gap: 1rem; margin-top: 2rem; }
	.btn { display: inline-flex; min-height: 48px; align-items: center; justify-content: center; padding: 0 1.5rem; border: 1px solid var(--sand); font-size: .78rem; font-weight: 600; letter-spacing: .06em; transition: background .2s, color .2s, border-color .2s; }
	.btn-primary { border-color: var(--gold); background: var(--gold); color: var(--bg); }
	.btn-primary:hover { border-color: #e0bc70; background: #e0bc70; }
	.btn-secondary { color: var(--sand); }
	.btn-secondary:hover { background: var(--sand); color: var(--bg); }
	.featured-game { background: var(--surface); }
	.feature-layout { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(2.5rem, 8vw, 7rem); align-items: center; }
	.feature-art { position: relative; min-height: 430px; overflow: hidden; background: linear-gradient(160deg, #8d7049, #4d402a 67%, #211e16); }
	.sun { position: absolute; top: 13%; right: 18%; width: 150px; aspect-ratio: 1; border-radius: 50%; background: #dbb779; box-shadow: 0 0 80px rgb(219 183 121 / 25%); }
	.ruin { position: absolute; right: 15%; bottom: 0; left: 35%; height: 58%; border: 18px solid #29251c; border-bottom: 0; border-radius: 90px 90px 0 0; box-shadow: inset 0 1px #b19768; }
	.feature-art-label { position: absolute; bottom: 1.5rem; left: 1.5rem; color: #eee0c2; font-size: .62rem; letter-spacing: .17em; }
	.feature-copy h2 { max-width: 500px; }
	.feature-copy p { color: var(--muted); font-size: .95rem; line-height: 1.8; }
	.feature-copy .game-subtitle { color: var(--sand); font-family: Georgia, serif; font-size: 1.15rem; }
	ul { padding-left: 1.2rem; margin: 1.5rem 0; color: var(--muted); }
	li { padding: .3rem 0; font-size: .9rem; }
	li::marker { color: var(--gold); }
	.text-link { display: inline-flex; gap: 1.25rem; align-items: center; padding-bottom: .5rem; border-bottom: 1px solid var(--gold); color: var(--text); font-size: .78rem; font-weight: 600; letter-spacing: .05em; }
	.text-link span { color: var(--gold); }
	.philosophy { background: #201e17; }
	.philosophy-inner { max-width: 850px; text-align: center; }
	.philosophy-inner h2 { margin: 1.4rem 0; }
	.philosophy-inner p { max-width: 700px; margin: 1rem auto; color: var(--muted); font-size: 1rem; line-height: 1.8; }
	.philosophy-inner .philosophy-lead { color: var(--text); font-family: Georgia, serif; font-size: clamp(1.2rem, 2.5vw, 1.7rem); }
	.philosophy-lead strong, .highlight { color: var(--gold) !important; }
	.philosophy-inner .highlight { font-family: Georgia, serif; font-size: 1.35rem; font-style: italic; }
	.pillars h2, .updates h2 { margin: .8rem 0 2.5rem; }
	.grid { display: grid; gap: 1rem; grid-template-columns: repeat(4, minmax(0, 1fr)); }
	.card { position: relative; padding: 1.75rem; border: 1px solid rgb(255 255 255 / 7%); background: var(--card); }
	.card-icon { color: var(--gold); font-size: 1.5rem; }
	.card h3 { margin: 1.4rem 0 .7rem; font-family: Georgia, serif; font-size: 1.25rem; font-weight: 400; }
	.card p { margin: 0; color: var(--muted); font-size: .85rem; line-height: 1.8; }
	.about { background: var(--surface); }
	.about-inner { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(2rem, 7vw, 6rem); align-items: center; }
	.about-art { position: relative; min-height: 400px; overflow: hidden; background: linear-gradient(#69573a, #a38354 70%, #51432d); }
	.about-sun { position: absolute; top: 15%; left: 25%; width: 145px; aspect-ratio: 1; border-radius: 50%; background: #d9b779; }
	.pyramid { position: absolute; bottom: 0; width: 0; height: 0; border-right: 170px solid transparent; border-bottom: 260px solid #423927; border-left: 170px solid transparent; }
	.pyramid-back { right: -9%; transform: scale(.7); transform-origin: bottom right; border-bottom-color: #716044; }
	.pyramid-front { right: 17%; }
	.coordinates { position: absolute; bottom: 1.2rem; left: 1.4rem; color: #eee0c2; font-size: .65rem; letter-spacing: .1em; line-height: 1.8; }
	.about-copy p { color: var(--muted); font-size: .95rem; line-height: 1.85; }
	.about-copy .highlight { padding-left: 1rem; border-left: 1px solid var(--gold); color: var(--sand) !important; font-family: Georgia, serif; font-size: 1.15rem; font-style: italic; }
	.updates { background: #0f0e0b; }
	.section-heading { display: flex; align-items: end; justify-content: space-between; gap: 2rem; }
	.section-heading p { max-width: 270px; color: var(--muted); font-size: .9rem; line-height: 1.8; }
	.update-grid { margin: 2rem 0; }
	.update-grid .card { min-height: 180px; }
	.update-number { color: var(--gold); font-size: .65rem; letter-spacing: .15em; }
	.update-grid .card h3 { margin-top: 2rem; }
	.community { text-align: center; background: radial-gradient(ellipse at 50% 0%, rgb(202 162 85 / 18%), transparent 65%), #201e17; }
	.community .container { max-width: 850px; }
	.community h2 { margin: 1rem 0; font-size: clamp(2.8rem, 7vw, 5.5rem); }
	.community p { max-width: 570px; margin: auto; color: var(--muted); line-height: 1.8; }
	.community .actions { justify-content: center; }
	.site-footer { display: flex; min-height: 90px; align-items: center; justify-content: space-between; gap: 1rem; padding: 1.5rem max(2rem, calc((100vw - 1200px) / 2)); border-top: 1px solid rgb(255 255 255 / 10%); background: var(--bg); }
	.site-footer p { color: var(--muted); font-family: Georgia, serif; font-size: .9rem; font-style: italic; }
	.footer-brand { color: var(--sand); font-size: .8rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; }
	.site-footer > a:last-child { color: var(--muted); font-size: .65rem; letter-spacing: .1em; text-transform: uppercase; }

	@media (max-width: 850px) {
		section { padding: 5rem 1.5rem; }
		.grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
		.feature-layout, .about-inner { grid-template-columns: 1fr; }
		.feature-art { min-height: 340px; }
		.about-art { min-height: 330px; }
		.section-heading { align-items: start; flex-direction: column; gap: 0; }
	}
	@media (max-width: 520px) {
		.container { width: min(100%, calc(100% - 1rem)); }
		section { padding: 4rem 1rem; }
		.hero { min-height: 85svh; }
		.hero h1 { font-size: clamp(2.7rem, 13vw, 4rem); }
		.grid { grid-template-columns: 1fr; }
		.card { padding: 1.4rem; }
		.site-footer { align-items: start; flex-direction: column; padding: 1.5rem; }
	}
</style>
