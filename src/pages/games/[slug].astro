---
import Layout from '../../layouts/Layout.astro';
import { games, type Game } from '../../data/games';

export function getStaticPaths() {
	return games.map((game) => ({
		params: { slug: game.slug },
		props: { game },
	}));
}

interface Props {
	game: Game;
}

const { game } = Astro.props;
---

<Layout
	title={`${game.title} | First Fragment`}
	description={`${game.title} is an archaeology-inspired game in development at First Fragment.`}
>
	<main class="game-page">
		<div class="container">
			<a class="back-link" href="/games/">← All games</a>
			<section aria-labelledby="game-title">
				<span class="eyebrow">First Fragment · In Development</span>
				<h1 id="game-title">{game.title}</h1>
				<p class="intro">
					{game.title} is currently in development. More details will be shared as the game takes shape.
				</p>
				<div class="actions">
					<a class="text-link" href="/">Visit First Fragment <span aria-hidden="true">↗</span></a>
					<a class="text-link" href="/contact/">Contact us <span aria-hidden="true">↗</span></a>
				</div>
			</section>
		</div>
	</main>
</Layout>

<style>
	:global(body) {
		margin: 0;
		background: #0b0a08;
		color: #f8f6f2;
		font-family: "Avenir Next", Avenir, "Segoe UI", sans-serif;
	}

	.game-page {
		display: flex;
		min-height: 100svh;
		align-items: center;
		padding: 3rem 2rem;
		background: radial-gradient(ellipse at 75% 38%, rgb(202 162 85 / 20%), transparent 50%), #0b0a08;
	}

	.container {
		width: min(900px, 100%);
		margin: auto;
	}

	.back-link {
		display: inline-block;
		margin-bottom: clamp(4rem, 12vh, 8rem);
		color: #d7b98a;
		font-size: .8rem;
	}

	.eyebrow {
		color: #caa255;
		font-size: .72rem;
		font-weight: 600;
		letter-spacing: .18em;
		text-transform: uppercase;
	}

	h1 {
		margin: 1.2rem 0;
		font-family: Georgia, "Times New Roman", serif;
		font-size: clamp(3rem, 9vw, 6.5rem);
		font-weight: 400;
		letter-spacing: -.055em;
		line-height: 1;
	}

	.intro {
		max-width: 600px;
		margin: 1.5rem 0 2rem;
		color: #c9c0b2;
		font-size: 1.05rem;
		line-height: 1.85;
	}

	.text-link {
		display: inline-flex;
		gap: 1rem;
		align-items: center;
		padding-bottom: .5rem;
		border-bottom: 1px solid #caa255;
		color: #f8f6f2;
		font-size: .8rem;
		font-weight: 600;
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 1.5rem;
	}

	.text-link span {
		color: #caa255;
	}

	@media (max-width: 520px) {
		.game-page {
			padding-inline: 1.25rem;
		}
	}
</style>
