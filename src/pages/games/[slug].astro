---
import Layout from "../../layouts/Layout.astro";
import GameTitle from "../../components/GameTitle.astro";
import { games, type Game } from "../../data/games";

export function getStaticPaths() {
	return games.map((game) => ({
		params: { slug: game.slug },
		props: { game },
	}));
}

interface Props {
	game: Game;
}

const { game } = Astro.props;
const baseUrl = import.meta.env.BASE_URL.endsWith("/")
	? import.meta.env.BASE_URL
	: `${import.meta.env.BASE_URL}/`;
---

<Layout
	title={`${game.title} | First Fragment`}
	description={game.storeDescription}
>
	<main class="game-page">
		<div class="container">
			<a class="back-link" href="/games/">← All games</a>
			<section
				class:list={[
					"game-detail",
					{
						"game-detail--with-character":
							game.slug === "henry-the-digger",
					},
				]}
				aria-labelledby="game-title"
			>
				<div>
					<span class="eyebrow">First Fragment · In Development</span>
					<h1 id="game-title"><GameTitle game={game} /></h1>
					<p class="intro">{game.storeDescription}</p>
					{
						game.slug === "henry-the-digger" && (
							<div class="character-art">
								<img
									src={`${baseUrl}HenryTheDigger/Media/HTDMainChar.gif`}
									alt="Henry, the main character of Henry the Digger"
									width="128"
									height="251"
								/>
							</div>
						)
					}
					{
						game.slug === "fossil-in-the-sand" && (
							<section
								class="concept-gallery"
								aria-labelledby="concept-gallery-title"
							>
								<h2 id="concept-gallery-title">
									Character concepts
								</h2>
								<div class="concept-gallery__grid">
									<figure class="concept-card">
										<div class="concept-card__frame">
											<img
												src={`${baseUrl}FossilInTheSand/FITS-FemaleLow.png`}
												alt="Female lead exploring an ancient underground ruin"
												width="1376"
												height="768"
											/>
										</div>
										<figcaption>Female Lead</figcaption>
									</figure>
									<figure class="concept-card">
										<div class="concept-card__frame">
											<img
												src={`${baseUrl}FossilInTheSand/FITS-MaleLow.png`}
												alt="Male lead exploring an ancient underground ruin"
												width="1376"
												height="768"
											/>
										</div>
										<figcaption>Male Lead</figcaption>
									</figure>
								</div>
							</section>
						)
					}
				</div>
				<div class="actions">
					<a class="text-link" href="/"
						>Visit First Fragment <span aria-hidden="true">↗</span
						></a
					>
					<a class="text-link" href="/contact/"
						>Contact us <span aria-hidden="true">↗</span></a
					>
				</div>
			</section>
		</div>
	</main>
</Layout>

<style>
	:global(body) {
		margin: 0;
		background: #0b0a08;
		color: #f8f6f2;
		font-family: "Avenir Next", Avenir, "Segoe UI", sans-serif;
	}

	.game-page {
		display: flex;
		min-height: 100svh;
		align-items: center;
		padding: 3rem 2rem;
		background:
			radial-gradient(
				ellipse at 75% 38%,
				rgb(202 162 85 / 20%),
				transparent 50%
			),
			#0b0a08;
	}

	.container {
		width: min(900px, 100%);
		margin: auto;
	}

	.game-overview {
		max-width: 700px;
		margin-top: clamp(3rem, 8vh, 5rem);
	}

	.game-overview h2 {
		margin: 0 0 1rem;
		color: #d7b98a;
		font-family: Georgia, "Times New Roman", serif;
		font-size: clamp(1.75rem, 4vw, 2.5rem);
		font-weight: 400;
	}

	.game-overview p {
		margin: 0;
		color: #c9c0b2;
		line-height: 1.85;
	}

	.game-detail--with-character {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(150px, 220px);
		gap: clamp(2rem, 7vw, 5rem);
		align-items: center;
	}

	.concept-gallery {
		margin-top: clamp(4rem, 10vh, 7rem);
	}

	.concept-gallery h2 {
		margin: 0 0 1.5rem;
		color: #d7b98a;
		font-family: Georgia, "Times New Roman", serif;
		font-size: clamp(1.75rem, 4vw, 2.5rem);
		font-weight: 400;
	}

	.concept-gallery__grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: clamp(1.5rem, 4vw, 2.5rem);
	}

	.concept-card {
		min-width: 0;
		margin: 0;
	}

	.concept-card__frame {
		padding: 0.65rem;
		border: 8px solid #795f36;
		outline: 2px solid #caa255;
		outline-offset: -4px;
		background: #17140f;
		box-shadow: 0 1rem 2rem rgb(0 0 0 / 35%);
	}

	.concept-card__frame img {
		display: block;
		width: 100%;
		height: auto;
	}

	.concept-card figcaption {
		margin-top: 0.9rem;
		color: #caa255;
		font-size: 0.75rem;
		font-weight: 600;
		letter-spacing: 0.14em;
		text-transform: uppercase;
	}

	.character-art {
		position: relative;
		display: flex;
		min-height: 340px;
		align-items: center;
		justify-content: center;
		padding: 1rem;
		border: 12px solid #795f36;
		outline: 2px solid #caa255;
		outline-offset: -5px;
		background: #fff;
		box-shadow:
			inset 0 0 0 2px rgb(11 10 8 / 75%),
			0 1rem 2rem rgb(0 0 0 / 35%);
	}

	.character-art img {
		display: block;
		width: min(100%, 176px);
		height: auto;
		filter: drop-shadow(0 1rem 2rem rgb(0 0 0 / 40%));
	}

	.back-link {
		display: inline-block;
		margin-bottom: clamp(4rem, 12vh, 8rem);
		color: #d7b98a;
		font-size: 0.8rem;
	}

	.eyebrow {
		color: #caa255;
		font-size: 0.72rem;
		font-weight: 600;
		letter-spacing: 0.18em;
		text-transform: uppercase;
	}

	.version-label {
		color: #caa255;
		font-size: 0.72rem;
		font-weight: 600;
		letter-spacing: 0.14em;
		text-transform: uppercase;
	}

	h1 {
		margin: 1.2rem 0;
		font-family: Georgia, "Times New Roman", serif;
		font-size: clamp(3rem, 9vw, 6.5rem);
		font-weight: 400;
		letter-spacing: -0.055em;
		line-height: 1;
	}

	.intro {
		max-width: 600px;
		margin: 0.75rem 0 2rem;
		color: #c9c0b2;
		font-size: 1.05rem;
		line-height: 1.85;
	}

	.text-link {
		display: inline-flex;
		gap: 1rem;
		align-items: center;
		padding-bottom: 0.5rem;
		border-bottom: 1px solid #caa255;
		color: #f8f6f2;
		font-size: 0.8rem;
		font-weight: 600;
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 1.5rem;
	}

	.text-link span {
		color: #caa255;
	}

	@media (max-width: 520px) {
		.game-page {
			padding-inline: 1.25rem;
		}

		.game-detail--with-character {
			grid-template-columns: 1fr;
			gap: 1.5rem;
		}

		.concept-gallery {
			margin-top: 4rem;
		}

		.concept-gallery__grid {
			grid-template-columns: 1fr;
			gap: 2rem;
		}

		.character-art {
			width: min(100%, 220px);
			min-height: 320px;
			justify-content: center;
		}

		.character-art img {
			width: min(100%, 160px);
		}
	}
</style>
