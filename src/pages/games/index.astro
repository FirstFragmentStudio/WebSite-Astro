---
import Layout from '../../layouts/Layout.astro';
import GameCard from '../../components/GameCard.astro';
import { games } from '../../data/games';
---

<Layout
	title="Games in Development | First Fragment"
	description="Explore the games currently in development at First Fragment."
>
	<main>
		<section class="games-page" aria-labelledby="games-title">
			<div class="container">
				<a class="back-link" href="/">← First Fragment</a>
				<span class="eyebrow">Our Games</span>
				<h1 id="games-title">Games in Development</h1>
				<p class="intro">Meet the games currently taking shape at First Fragment.</p>
				<div class="games-grid">
					{games.map((game) => <GameCard game={game} />)}
				</div>
				<a class="contact-link" href="/contact/">Contact First Fragment</a>
			</div>
		</section>
	</main>
</Layout>

<style>
	:global(body) {
		margin: 0;
		background: #0b0a08;
		color: #f8f6f2;
		font-family: "Avenir Next", Avenir, "Segoe UI", sans-serif;
	}

	.games-page {
		min-height: 100svh;
		padding: clamp(3rem, 8vw, 7rem) 2rem;
		background: radial-gradient(ellipse at 78% 10%, rgb(202 162 85 / 16%), transparent 48%), #0b0a08;
	}

	.container {
		width: min(1100px, 100%);
		margin: auto;
	}

	.back-link {
		display: inline-block;
		margin-bottom: 4rem;
		color: #d7b98a;
		font-size: .8rem;
	}

	.eyebrow {
		display: block;
		color: #caa255;
		font-size: .72rem;
		font-weight: 600;
		letter-spacing: .18em;
		text-transform: uppercase;
	}

	h1 {
		margin: 1rem 0;
		font-family: Georgia, "Times New Roman", serif;
		font-size: clamp(2.8rem, 7vw, 5rem);
		font-weight: 400;
		letter-spacing: -.045em;
	}

	.intro {
		margin: 0;
		color: #c9c0b2;
		line-height: 1.8;
	}

	.contact-link {
		display: inline-block;
		margin-top: 2rem;
		padding-bottom: .4rem;
		border-bottom: 1px solid #caa255;
		color: #f8f6f2;
		font-size: .8rem;
		font-weight: 600;
	}

	.games-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1rem;
		margin-top: 3rem;
	}

	@media (max-width: 620px) {
		.games-page {
			padding-inline: 1.25rem;
		}

		.back-link {
			margin-bottom: 3rem;
		}

		.games-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
