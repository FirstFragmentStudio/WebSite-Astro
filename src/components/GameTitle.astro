---
import type { Game } from '../data/games';

interface Props {
	game: Game;
}

const { game } = Astro.props;
const baseUrl = import.meta.env.BASE_URL.endsWith('/')
	? import.meta.env.BASE_URL
	: `${import.meta.env.BASE_URL}/`;
---

{game.titleImage ? (
	<img
		src={`${baseUrl}${game.titleImage.src}`}
		alt={game.title}
		width={game.titleImage.width}
		height={game.titleImage.height}
	/>
) : game.title}

<style>
	img {
		display: block;
		width: 100%;
		max-width: 427px;
		height: auto;
	}
</style>
