---
import type { Game } from '../data/games';

interface Props {
	game: Game;
}

const { game } = Astro.props;
---

<a class="game-card" href={`/games/${game.slug}/`}>
	<span class="game-card-status">In development</span>
	<h3>{game.title}</h3>
	<span class="game-card-link">Discover the game <span aria-hidden="true">↗</span></span>
</a>

<style>
	.game-card {
		display: flex;
		min-height: 220px;
		flex-direction: column;
		align-items: flex-start;
		justify-content: space-between;
		padding: 1.75rem;
		border: 1px solid rgb(255 255 255 / 12%);
		background: linear-gradient(145deg, #211c17, #171411);
		color: #f8f6f2;
		transition: border-color .2s, transform .2s;
	}

	.game-card:hover,
	.game-card:focus-visible {
		transform: translateY(-3px);
		border-color: #caa255;
	}

	.game-card-status {
		color: #caa255;
		font-size: .68rem;
		font-weight: 600;
		letter-spacing: .14em;
		text-transform: uppercase;
	}

	h3 {
		margin: 2rem 0;
		font-family: Georgia, "Times New Roman", serif;
		font-size: clamp(1.5rem, 3vw, 2.25rem);
		font-weight: 400;
	}

	.game-card-link {
		display: inline-flex;
		gap: 1rem;
		align-items: center;
		padding-bottom: .4rem;
		border-bottom: 1px solid #caa255;
		font-size: .78rem;
		font-weight: 600;
		letter-spacing: .04em;
	}

	.game-card-link span {
		color: #caa255;
	}
</style>
